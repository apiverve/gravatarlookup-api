{
    "name": "apiverve/gravatarlookup",
    "description": "Gravatar Lookup is a Gravatar API for email lookups: send an email address and get its public Gravatar profile and avatar image URL. It returns the display name, username, biography, location, company, job title and pronouns; paid plans add linked accounts (hidden ones flagged) and whether the email has its own uploaded avatar.",
    "version": "1.2.6",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "gravatarlookup",
        "gravatar api",
        "email to avatar",
        "gravatar profile lookup",
        "find gravatar by email",
        "get gravatar image url"
    ],
    "homepage": "https://apiverve.com/marketplace/gravatarlookup?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/gravatarlookup",
        "source": "https://github.com/apiverve/gravatarlookup-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Gravatarlookup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Gravatarlookup\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
